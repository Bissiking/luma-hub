# .env.example — LUMA Hub × Kyros (SSO v4)
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------- Kyros
KYROS_BASE_URL=http://localhost:3001

# Endpoints SSO v4 (déduits de KYROS_BASE_URL s'ils sont absents).
KYROS_PAR_URL=http://localhost:3001/par
KYROS_AUTHORIZE_URL=http://localhost:3001/authorize
KYROS_TOKEN_URL=http://localhost:3001/token
KYROS_REVOKE_URL=http://localhost:3001/revoke
KYROS_JWKS_URL=http://localhost:3001/sso/v4/jwks

# Client SSO v4 enregistré dans Kyros (Administration → Clients SSO & OIDC) :
#   protocole SSO v4 · mode sso · périmètre standard
#   audience de ressource (tokenAudience) = kyros:hub
#   scopes = profile email offline_access hub:read hub:preferences
#   callbacks = http://localhost:3000/auth/callback , https://mhemery.fr/auth/callback
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=

# Handshake strict : doit correspondre au client enregistré.
KYROS_SSO_VERSION=v4
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard

# Claims attendus dans l'access token RS256 (vérifiés via KYROS_JWKS_URL).
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:hub

# Scopes demandés au PAR / minimum exigé pour ouvrir une session.
KYROS_REQUESTED_SCOPE=profile email hub:read hub:preferences
KYROS_REQUIRED_SCOPES=profile email hub:read

KYROS_TIMEOUT_SECONDS=5
