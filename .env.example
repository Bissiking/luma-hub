# .env.example
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_TTL_HOURS=12

AUTH_PROVIDER=kyros
KYROS_BASE_URL=http://localhost:3001

# Optionnels : déduits automatiquement de KYROS_BASE_URL s'ils sont absents.
KYROS_AUTHORIZE_URL=http://localhost:3001/authorize
KYROS_TOKEN_URL=http://localhost:3001/token

KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_REQUESTED_SCOPE=profile email
KYROS_TIMEOUT_SECONDS=5

# L'endpoint des applications est volontairement fixe :
# ${KYROS_BASE_URL}/api/apps/me
