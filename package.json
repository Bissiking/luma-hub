{
  "name": "luma-hub",
  "version": "1.0.0-alpha.6",
  "description": "Portail principal LUMA pour mhemery.fr, connecté à Kyros (SSO v4).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:kyros": "node scripts/kyros-contract-test.mjs",
    "test:drivio": "node scripts/drivio-contract-test.mjs",
    "test:harmonix": "node scripts/harmonix-browser-test.mjs",
    "test:projects": "node scripts/projects-browser-test.mjs",
    "catalogue:import": "node scripts/import-projects.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^6.2.13",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1"
  }
}
